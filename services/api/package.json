{
  "name": "@relayrtc/api",
  "version": "0.0.0",
  "description": "Versioned public REST API for RelayRTC.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rimraf dist coverage",
    "lint": "eslint .",
    "usage:aggregate": "node --env-file-if-exists=../../.env dist/modules/reporting/refresh-usage.js",
    "start": "node --enable-source-maps dist/server.js",
    "test": "vitest run --pool=threads --exclude dist/**",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@relayrtc/auth": "workspace:*",
    "@relayrtc/protocol": "workspace:*",
    "@relayrtc/database": "workspace:*",
    "@relayrtc/types": "workspace:*",
    "@relayrtc/validation": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1"
  }
}
