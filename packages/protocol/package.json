{
  "name": "@relayrtc/protocol",
  "version": "0.0.0",
  "description": "Versioned realtime wire contracts for RelayRTC.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rimraf dist coverage",
    "lint": "eslint .",
    "test": "vitest run --pool=threads --exclude dist/**",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@relayrtc/types": "workspace:*",
    "@relayrtc/validation": "workspace:*",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
