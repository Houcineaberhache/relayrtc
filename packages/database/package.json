{
  "name": "@relayrtc/database",
  "version": "0.0.0",
  "description": "PostgreSQL schema, migrations, and database client for RelayRTC.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "migrations"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "clean": "rimraf dist coverage",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "lint": "eslint .",
    "test": "vitest run --pool=threads --exclude dist/**",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
